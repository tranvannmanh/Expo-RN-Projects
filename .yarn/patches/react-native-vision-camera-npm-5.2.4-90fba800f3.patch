+package com.margelo.nitro.camera.extensions
+
+import android.content.Context
+import android.hardware.camera2.CameraCaptureSession
+import android.hardware.camera2.CameraCharacteristics
+import android.hardware.camera2.CameraManager
+import android.hardware.camera2.CaptureRequest
+import android.hardware.camera2.CaptureResult
+import android.hardware.camera2.TotalCaptureResult
+import android.hardware.camera2.params.ColorSpaceTransform
+import com.margelo.nitro.NitroModules
+
+/**
+ * [Film Studio patch] Records the sensor exposure actually used by the
+ * repeating request, so JS can read live ISO / shutter values (CameraX
+ * does not expose them) and meter for shutter-priority exposure.
+ */
+object ExposureTracker {
+  @Volatile var iso: Int = 0
+    private set
+
+  @Volatile var exposureTimeNs: Long = 0
+    private set
+
+  /**
+   * Colour matrix the camera used while its own white balance ran; manual
+   * white-balance gains are combined with it (identity would desaturate).
+   */
+  @Volatile var autoColorTransform: ColorSpaceTransform? = null
+    private set
+
+  val callback =
+    object : CameraCaptureSession.CaptureCallback() {
+      override fun onCaptureCompleted(
+        session: CameraCaptureSession,
+        request: CaptureRequest,
+        result: TotalCaptureResult,
+      ) {
+        result.get(CaptureResult.SENSOR_SENSITIVITY)?.let { iso = it }
+        result.get(CaptureResult.SENSOR_EXPOSURE_TIME)?.let { exposureTimeNs = it }
+        if (result.get(CaptureResult.CONTROL_AWB_MODE) != CaptureResult.CONTROL_AWB_MODE_OFF) {
+          result.get(CaptureResult.COLOR_CORRECTION_TRANSFORM)?.let { autoColorTransform = it }
+        }
+      }
+    }
+
+  /**
+   * CameraX (camera2-pipe) filters REQUEST_AVAILABLE_CAPABILITIES down to the
+   * capabilities it uses itself, so MANUAL_SENSOR has to be read from the
+   * framework's CameraManager.
+   */
+  fun supportsManualSensor(cameraId: String?): Boolean =
+    hasCapability(cameraId, CameraCharacteristics.REQUEST_AVAILABLE_CAPABILITIES_MANUAL_SENSOR)
+
+  /** Manual colour gains (white balance by temperature) need MANUAL_POST_PROCESSING. */
+  fun supportsManualPostProcessing(cameraId: String?): Boolean =
+    hasCapability(cameraId, CameraCharacteristics.REQUEST_AVAILABLE_CAPABILITIES_MANUAL_POST_PROCESSING)
+
+  /** White-balance presets (CONTROL_AWB_MODE_*) this camera accepts. */
+  fun availableAwbModes(cameraId: String?): IntArray =
+    characteristics(cameraId)?.get(CameraCharacteristics.CONTROL_AWB_AVAILABLE_MODES) ?: IntArray(0)
+
+  private fun hasCapability(cameraId: String?, capability: Int): Boolean =
+    characteristics(cameraId)?.get(CameraCharacteristics.REQUEST_AVAILABLE_CAPABILITIES)?.contains(capability) == true
+
+  private fun characteristics(cameraId: String?): CameraCharacteristics? {
+    val id = cameraId ?: return null
+    val context = NitroModules.applicationContext ?: return null
+    return try {
+      (context.getSystemService(Context.CAMERA_SERVICE) as CameraManager).getCameraCharacteristics(id)
+    } catch (_: Exception) {
+      null
+    }
+  }
+}
