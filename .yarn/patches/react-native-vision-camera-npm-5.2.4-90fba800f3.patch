+package com.margelo.nitro.camera.extensions
+
+import android.content.Context
+import android.hardware.camera2.CameraCaptureSession
+import android.hardware.camera2.CameraCharacteristics
+import android.hardware.camera2.CameraManager
+import android.hardware.camera2.CaptureRequest
+import android.hardware.camera2.CaptureResult
+import android.hardware.camera2.TotalCaptureResult
+import com.margelo.nitro.NitroModules
+
+/**
+ * [Film Studio patch] Records the sensor exposure actually used by the
+ * repeating request, so JS can read live ISO / shutter values (CameraX
+ * does not expose them) and meter for shutter-priority exposure.
+ */
+object ExposureTracker {
+  @Volatile var iso: Int = 0
+    private set
+
+  @Volatile var exposureTimeNs: Long = 0
+    private set
+
+  val callback =
+    object : CameraCaptureSession.CaptureCallback() {
+      override fun onCaptureCompleted(
+        session: CameraCaptureSession,
+        request: CaptureRequest,
+        result: TotalCaptureResult,
+      ) {
+        result.get(CaptureResult.SENSOR_SENSITIVITY)?.let { iso = it }
+        result.get(CaptureResult.SENSOR_EXPOSURE_TIME)?.let { exposureTimeNs = it }
+      }
+    }
+
+  /**
+   * CameraX (camera2-pipe) filters REQUEST_AVAILABLE_CAPABILITIES down to the
+   * capabilities it uses itself, so MANUAL_SENSOR has to be read from the
+   * framework's CameraManager.
+   */
+  fun supportsManualSensor(cameraId: String?): Boolean {
+    val id = cameraId ?: return false
+    val context = NitroModules.applicationContext ?: return false
+    return try {
+      val manager = context.getSystemService(Context.CAMERA_SERVICE) as CameraManager
+      manager
+        .getCameraCharacteristics(id)
+        .get(CameraCharacteristics.REQUEST_AVAILABLE_CAPABILITIES)
+        ?.contains(CameraCharacteristics.REQUEST_AVAILABLE_CAPABILITIES_MANUAL_SENSOR) == true
+    } catch (_: Exception) {
+      false
+    }
+  }
+}
