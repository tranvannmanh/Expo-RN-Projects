{
	"name": "pers-projects",
	"main": "expo-router/entry",
	"version": "1.0.0",
	"dependencies": {
		"@expo/ui": "~56.0.18",
		"@hookform/resolvers": "^5.4.0",
		"@tanstack/react-query": "^5.101.0",
		"expo": "~56.0.12",
		"expo-constants": "~56.0.18",
		"expo-dev-client": "~56.0.28",
		"expo-device": "~56.0.4",
		"expo-file-system": "~56.0.11",
		"expo-font": "~56.0.7",
		"expo-glass-effect": "~56.0.4",
		"expo-image": "~56.0.11",
		"expo-linking": "~56.0.14",
		"expo-router": "~56.2.11",
		"expo-sharing": "~56.0.27",
		"expo-splash-screen": "~56.0.10",
		"expo-sqlite": "~56.0.6",
		"expo-status-bar": "~56.0.4",
		"expo-symbols": "~56.0.6",
		"expo-system-ui": "~56.0.5",
		"expo-web-browser": "~56.0.5",
		"react": "19.2.3",
		"react-dom": "19.2.3",
		"react-hook-form": "^7.79.0",
		"react-native": "0.85.3",
		"react-native-gesture-handler": "~2.31.1",
		"react-native-mmkv": "^4.3.1",
		"react-native-nitro-modules": "^0.35.9",
		"react-native-reanimated": "4.3.1",
		"react-native-safe-area-context": "~5.7.0",
		"react-native-screens": "4.25.2",
		"react-native-web": "~0.21.0",
		"react-native-worklets": "0.8.3",
		"zod": "^4.4.3",
		"zustand": "^5.0.14"
	},
	"devDependencies": {
		"@react-native/jest-preset": "0.85.3",
		"@types/jest": "29.5.14",
		"@types/react": "~19.2.2",
		"jest": "~29.7.0",
		"jest-expo": "~56.0.6",
		"typescript": "~6.0.3"
	},
	"scripts": {
		"start": "expo start",
		"reset-project": "node ./scripts/reset-project.js",
		"android": "expo run:android",
		"ios": "expo run:ios",
		"web": "expo start --web",
		"lint": "expo lint",
		"prebuild:a": "expo prebuild --platform android",
		"apk": "cd android && ./gradlew assembleRelease && cd ..",
		"test": "jest",
		"test:watch": "jest --watch"
	},
	"private": true,
	"jest": {
		"preset": "jest-expo",
		"setupFilesAfterEnv": [
			"<rootDir>/jest/setup.ts"
		],
		"moduleNameMapper": {
			"^@/(.*)$": "<rootDir>/src/$1",
			"^@modules/(.*)$": "<rootDir>/modules/$1"
		},
		"testPathIgnorePatterns": [
			"/node_modules/",
			"/android/",
			"/ios/"
		],
		"collectCoverageFrom": [
			"src/features/document-scanner/{repositories,services,utils,types}/**/*.ts",
			"src/shared/database/**/*.ts",
			"modules/document-scanner/{index.ts,src/**/*.ts}"
		]
	}
}
